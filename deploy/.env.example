# Copy to .env (same folder) and fill in. Never commit .env.

# Your domain, already pointing at this server (an A record). Example: nook.example.com
DOMAIN=

# Password of the database inside Docker. Letters and digits only (it goes into an address).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens, 32+ characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional. Google sign-in: client IDs, comma separated. Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=
# Optional. Push notifications: the Firebase key file as one line of base64 (base64 -w0 key.json).
# Empty = push off.
FIREBASE_SERVICE_ACCOUNT=

# Only to run the example on a machine where 80, 443 or 5432 are busy (not needed on a server):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# POSTGRES_HOST_PORT=5433
