NODE_ENV=development
PORT=3000

# Neon connection string; keep sslmode (verify-full = TLS with certificate check)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Public URL of the deployed service; leave unset locally
# SELF_PING_URL=https://your-service.onrender.com

# Signs login tokens: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google OAuth client IDs (Web client of the Firebase/Google Cloud project), comma separated.
# Leave unset to disable Google sign-in.
# GOOGLE_CLIENT_IDS=123456-abc.apps.googleusercontent.com

# Firebase service account key (Firebase console -> Project settings -> Service accounts ->
# Generate new private key), the file encoded as one line of base64:  base64 -w0 key.json
# A secret: only here and in the host's variables. Leave unset to switch push notifications off.
FIREBASE_SERVICE_ACCOUNT=

# Reverse proxies in front of the server (request limits use the client address behind them).
# 0 = none (local). On Render it is 3 (measured, see MEMORY.md); the usual "1" is wrong there.
# TRUST_PROXY_HOPS=3
